# ==========================================
# Kosmetik Halal NLP & Explainable AI - Environment Configuration
# ==========================================

# Application Environment (development, production, testing)
APP_ENV=development
APP_DEBUG=true
APP_NAME="Kosmetik Halal NLP & XAI Analytics"

# Server Host & Port
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=3000

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration
DATABASE_URL=sqlite:///./data/history.db

# NLP & Machine Learning Settings
DEFAULT_MODEL=indobert
INDOBERT_MODEL_NAME=indobenchmark/indobert-base-p1
INDOBERT_TRUST_MODEL_PATH=models/indobert_trust
INDOBERT_ASPECT_MODEL_PATH=models/indobert_aspect
SIMILARITY_THRESHOLD=0.85

# Dataset Paths
RAW_DATA_PATH=data/raw/female_daily_skincare_reviews_raw.csv
ANNOTATED_DATA_DIR=data/annotated
CLEANED_DATA_DIR=data/cleaned
